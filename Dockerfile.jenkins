
FROM jenkins/jenkins:lts-jdk21

USER root

# Instala as ferramentas necessárias
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# Instala uv para gerenciar o Python
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Instala Python 3.13
ENV UV_PYTHON_INSTALL_DIR=/opt/python

RUN uv python install 3.13 && \
    ln -s "$(uv python find 3.13)" /usr/local/bin/python3.13 && \
    ln -s /usr/local/bin/python3.13 /usr/local/bin/python3 && \
    ln -s /usr/local/bin/python3.13 /usr/local/bin/python

# Instala Poetry em ambiente virtual separado
RUN python3.13 -m venv /opt/poetry && \
    /opt/poetry/bin/pip install --no-cache-dir poetry==2.5.1

ENV PATH="/opt/poetry/bin:${PATH}"

# Retorna ao usuário não privilegiado
USER jenkins
